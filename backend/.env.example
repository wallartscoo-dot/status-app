# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# Local dev example: postgresql://postgres:postgres@localhost:5432/statusapp
DATABASE_URL=postgresql://neondb_owner:npg_ToFH4GgKWIA6@ep-small-union-zak3q4wy-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# JWT secrets — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=2567289875932e3c12ae85ac85cf703f40292dc2122126f602ddfec05a719256
JWT_REFRESH_SECRET=c2715510560f081c997959369b38ec1755269a6ae895bf67d4c1c3688f0279c4
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-free single origin, or "*" for local dev only — lock this down in production
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Media storage (Phase 3) ---
# Local-disk adapter by default (files land in ./uploads, served at /media).
# See src/config/storage.ts to swap in S3/Cloudinary/etc. for production.
UPLOAD_DIR=uploads
# Leave blank to auto-derive from PORT (http://localhost:$PORT/media).
# Set explicitly if the API is behind a different public URL/CDN.
PUBLIC_MEDIA_BASE_URL=
MAX_VIDEO_MB=30
MAX_IMAGE_MB=10

# Note: POST /api/statuses/upload accepts a real multipart file (field name
# "media") as of Phase 3 — video/mp4, video/quicktime, video/webm,
# image/jpeg, image/png, image/webp, up to the caps above. Videos over 30
# seconds are rejected per spec section 6 (durationSec must be supplied by
# the client and is capped at 30).
